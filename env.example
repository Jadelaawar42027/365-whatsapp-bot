# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=pick_any_random_string_you_invent_yourself

# --- Claude API ---
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- GHL MCP server (the 365-ai-bot repo, deployed separately) ---
# Local dev: point at your local ngrok tunnel for server-http.js (different port/tunnel than this bot)
# Production: point at wherever you deploy server-http.js (Railway/Render URL) + /mcp
GHL_MCP_URL=https://your-ghl-mcp-server-url/mcp
GHL_MCP_AUTH_TOKEN=same_value_as_MCP_AUTH_TOKEN_in_the_ghl_mcp_server_env

# --- Server ---
PORT=3000
