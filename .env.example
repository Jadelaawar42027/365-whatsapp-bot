# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=pick_any_random_string_you_invent_yourself

# --- Claude API ---
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Knowledge base (Google Docs, exported as plain text) ---
GOOGLE_DOC_KNOWLEDGE_ID=your_broker_leadership_knowledge_base_doc_id
# Optional - a SECOND broker/leadership knowledge base doc, combined WITH the doc
# above (not a replacement) - both docs' content get included together. Leave unset
# to keep using just the primary doc above, unchanged.
GOOGLE_DOC_KNOWLEDGE_ID_2=your_second_broker_knowledge_base_doc_id
# Optional - a SEPARATE doc with setter-specific SOPs (outbound qualification/booking),
# distinct from the broker/leadership doc(s) above. Only needed once you're ready to
# onboard setters; until it's set, setters get the generic fallback knowledge base
# rather than silently seeing the broker doc's content.
GOOGLE_DOC_SETTER_KNOWLEDGE_ID=your_setter_knowledge_base_doc_id

# --- Slack (second input/output channel, reuses the same Claude/MCP core as WhatsApp) ---
# Bot User OAuth Token, from api.slack.com/apps -> your app -> OAuth & Permissions.
# Needs the chat:write, im:history, and im:read bot token scopes.
SLACK_BOT_TOKEN=xoxb-your-bot-user-oauth-token
# From api.slack.com/apps -> your app -> Basic Information -> Signing Secret.
# Used to verify incoming Events API requests are genuinely from Slack.
SLACK_SIGNING_SECRET=your_slack_signing_secret

# --- Business analytics MCP server (leadership-only, ad-hoc business consultant tools) ---
# Optional - only used when identity.role === "leadership". Until this is set, leadership
# just doesn't get the extra analytics tools; nothing else is affected.
YACHTS_ANALYTICS_MCP_URL=https://your-yachts-analytics-mcp-url/mcp

# --- Server ---
PORT=3000
