# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=pick_any_random_string_you_invent_yourself

# --- Claude API ---
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Knowledge base (Google Docs, exported as plain text) ---
GOOGLE_DOC_KNOWLEDGE_ID=your_broker_leadership_knowledge_base_doc_id
# Optional - the "Broker Master Reference" doc (large - tens of thousands of tokens),
# fetched on demand ONLY when a broker/leadership message contains "master doc"
# (e.g. "use the master doc..."), injected for that one turn only - NOT included in
# every system prompt like the primary doc above, since it's too large for that.
# Leave unset and this trigger just tells the user it isn't configured yet.
GOOGLE_DOC_KNOWLEDGE_ID_2=your_master_reference_doc_id
# Optional - a SEPARATE doc with setter-specific SOPs (outbound qualification/booking),
# distinct from the broker/leadership doc(s) above. Only needed once you're ready to
# onboard setters; until it's set, setters get the generic fallback knowledge base
# rather than silently seeing the broker doc's content.
GOOGLE_DOC_SETTER_KNOWLEDGE_ID=your_setter_knowledge_base_doc_id

# --- Main Leads sheet (Google Sheets, exported as CSV) ---
# Optional - the "Main Leads" tab (gid=0) of the deals tracking sheet, leadership's own
# hand-maintained list of genuinely significant leads. Used ONLY by the morning digest, as a
# cross-check against GHL's own hot/priority tags (see mainLeadsSheet.js + digest.js). Must be
# shared as "Anyone with the link -> Viewer" - no OAuth/service account needed, same as the
# knowledge base docs above. Leave unset and the digest just runs without this cross-check.
GOOGLE_SHEET_MAIN_LEADS_ID=your_main_leads_sheet_id

# --- Slack (second input/output channel, reuses the same Claude/MCP core as WhatsApp) ---
# Bot User OAuth Token, from api.slack.com/apps -> your app -> OAuth & Permissions.
# Needs the chat:write, im:history, and im:read bot token scopes.
SLACK_BOT_TOKEN=xoxb-your-bot-user-oauth-token
# From api.slack.com/apps -> your app -> Basic Information -> Signing Secret.
# Used to verify incoming Events API requests are genuinely from Slack.
SLACK_SIGNING_SECRET=your_slack_signing_secret

# --- Business analytics MCP server (leadership-only, ad-hoc business consultant tools) ---
# Optional - only used when identity.role === "leadership". Until this is set, leadership
# just doesn't get the extra analytics tools; nothing else is affected.
YACHTS_ANALYTICS_MCP_URL=https://your-yachts-analytics-mcp-url/mcp

# --- AI memory layer (Postgres, Railway) ---
# The bot's own connection string, using the least-privilege `aibot_app` role
# (see sql/setup_aibot_role.sql) - no DELETE/DROP/TRUNCATE, INSERT/UPDATE
# only where the app is meant to write. Leave unset and the bot just runs
# without memory tools (get_contact_memory/record_contact_interaction aren't
# offered to the AI at all) - nothing else is affected.
AIBOT_DATABASE_URL=postgresql://aibot_app:password@host:5432/railway
# Admin/superuser connection string, used ONLY for running migrations
# (`npm run migrate:up`) and the one-time sql/setup_aibot_role.sql script -
# never set this on the bot service itself. This is Railway's own default
# Postgres plugin variable, typically already named DATABASE_URL there.
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# --- Server ---
PORT=3000
